# URL publique du site (sans slash final). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Clé service_role : utilisée uniquement côté serveur (API routes, webhook, admin). Ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe — Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Signing secret du webhook (Developers → Webhooks → endpoint /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — API Keys. L'adresse d'envoi doit appartenir à un domaine vérifié.
RESEND_API_KEY=re_...
RESEND_FROM="La Couvrière <reservations@lacouvriere.re>"
# Copie de chaque confirmation envoyée au propriétaire (optionnel)
OWNER_NOTIFICATION_EMAIL=contact@lacouvriere.re

# Admin — /admin
ADMIN_PASSWORD=change-me
# Secret aléatoire (32+ caractères) servant à signer le cookie de session admin
ADMIN_SESSION_SECRET=change-me-too-with-a-long-random-string
